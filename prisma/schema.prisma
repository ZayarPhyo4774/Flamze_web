generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
 // Connection URL moved to prisma.config.ts for Prisma v7+.
}

model Branch {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  address         String?
  phone           String?
  openingHours    String?
  mapUrl          String?
  imageUrl        String?
  menuItems       MenuItem[]
  branchMenuItems BranchMenuItem[]
  menuViews       MenuView[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  nameMy    String?
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  menuItems MenuItem[]

  @@index([parentId])
}

model MenuItem {
  id              String           @id @default(cuid())
  name            String
  nameMy          String?
  description     String?
  descriptionMy   String?
  price           Float
  image           String?
  rating          Int              @default(0)
  branchId        String
  categoryId      String
  isAvailable     Boolean          @default(true)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id])
  branchMenuItems BranchMenuItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([branchId, categoryId])
}

model BranchMenuItem {
  id          String   @id @default(cuid())
  branchId    String
  menuItemId  String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([branchId, menuItemId])
  @@index([branchId])
  @@index([menuItemId])
}

model MenuView {
  id        String   @id @default(cuid())
  branchId  String
  locale    String   @default("en")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([branchId, createdAt])
}

model LandingPage {
  id            String   @id @default("default")
  eyebrowEn     String   @default("")
  eyebrowMy     String?
  titleEn       String   @default("")
  titleMy       String?
  subtitleEn    String   @default("")
  subtitleMy    String?
  ctaLabelEn    String   @default("")
  ctaLabelMy    String?
  ctaHref       String   @default("/menu?branch=yangon")
  heroVideoUrl       String   @default("/video/hero.mp4")
  heroVideoUrlMobile String?
  heroPosterUrl      String?
  heroPosterUrlMobile String?
  updatedAt     DateTime @updatedAt
}

model LandingSection {
  id             String   @id @default(cuid())
  key            String   @unique
  sortOrder      Int      @default(0)
  isVisible      Boolean  @default(true)
  eyebrowEn      String?
  eyebrowMy      String?
  titleEn        String?
  titleMy        String?
  descriptionEn  String?
  descriptionMy  String?
  ctaLabelEn     String?
  ctaLabelMy     String?
  ctaHref        String?
  imageUrl       String?
  updatedAt      DateTime @updatedAt
}

model NavLink {
  id        String   @id @default(cuid())
  labelEn   String
  labelMy   String?
  href      String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
